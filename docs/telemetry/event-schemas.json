      "x-metricas": ["A5"],
      "description": "Visualización de una sección de UI.",
      "type": "object",
      "required": ["section_id", "user_uuid"],
      "additionalProperties": false,
      "properties": {
        "section_id": { "type": "string", "description": "Identificador de la sección." },
        "user_uuid": { "type": "string", "format": "uuid", "description": "Usuario que visualizó (seudonimizado)." },
        "time_on_section_ms": { "type": "integer", "description": "Tiempo estimado en la sección." }
      }
    },
    "form_abandoned": {
      "x-catalog-number": 16,
      "x-category": "frontend",
      "x-emisible-hoy": false,
      "x-metricas": ["A6"],
      "description": "Abandono de formulario. Requiere heartbeat (no fiable con beforeunload). Emparejamiento con form_opened por instance_id; ventana de exclusión de 5 min (D13); timeout de inactividad pendiente (D16).",
      "type": "object",
      "required": ["form_id", "instance_id"],
      "additionalProperties": false,
      "properties": {
        "form_id": { "type": "string", "description": "Identificador del formulario abandonado." },
        "instance_id": { "type": "string", "format": "uuid", "description": "Identificador de la instancia (para emparejar con form_opened y con eventos de éxito)." },
