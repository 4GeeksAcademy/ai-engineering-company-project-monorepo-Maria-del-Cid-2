# Variables de entorno para la API de Nexova
# Copia este archivo como .env y sustituye los valores de ejemplo.
# NUNCA subas .env al repositorio.
SECRET_KEY=pon-aqui-una-clave-segura-de-al-menos-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Private PostgreSQL/Supabase destination for append-only telemetry. It is
# intentionally separate from DATABASE_URL, which may point to SQLite for
# inventory in local development. Never use a NEXT_PUBLIC_ variable here.
TELEMETRY_DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres
