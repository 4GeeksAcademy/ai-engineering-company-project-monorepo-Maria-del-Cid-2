# Required by docker-compose interpolation. Copy this file to `.env` only when
# `.env` does not already exist; otherwise merge the missing keys manually.
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001
BACKEND_PORT=8000
NEXT_INTERNAL_PORT=3002
BACKEND_URL=http://backend:8000
NEXT_PUBLIC_NEXOVA_API_BASE=/api
NEXT_PUBLIC_INCIDENT_ANALYSIS_API_BASE=/api
DOCKER_NETWORK_NAME=nexova-dev-network
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Required by FastAPI authentication. Use a unique local-only value.
SECRET_KEY=local-development-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000/reset-password

# Local TinyDB persistence inside the mounted services/data directory.
AUTH_DB_PATH=/app/services/data/auth.json
SUPPLIER_DIRECTORY_DB_PATH=/app/services/data/suppliers.json
INCIDENTS_DB_PATH=/app/services/data/incidents.json

# Local development uses SQLite for inventory so no third database container is required.
DATABASE_URL=sqlite:////app/services/data/inventory.db

# Optional email configuration. Leave the API key empty for local development.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nexova <onboarding@resend.dev>
